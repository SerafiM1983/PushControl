<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">


    <fragment
        android:id="@+id/nav_home"
        android:name="com.serafimApp.pushcontrol.ui.home.HomeFragment"
        android:label="@string/general_feed"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/nav_bout_app"
        android:name="com.serafimApp.pushcontrol.ui.curtain.BoutTheAppsFragment"
        android:label="@string/bout_the_apps"
        tools:layout="@layout/bout_the_app" />
    <fragment
        android:id="@+id/nav_setting_user_bottom"
        android:name="com.serafimApp.pushcontrol.ui.curtain.SetingUserFragment"
        android:label="@string/settings_user_bottom"
        tools:layout="@layout/fragment_seting_user"/>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.serafimApp.pushcontrol.ui.settings.FragmentSetting"
        android:label="@string/settings_app"
        tools:layout="@layout/fragment_settings" />
</navigation>