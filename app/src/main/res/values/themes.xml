<resources xmlns:tools="http://android.com">
    <!-- Base application theme. -->
    <style name="Theme.PushControl" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Указываем ссылку на наш кастомный стиль для выпадающего меню -->
        <item name="popupTheme">@style/Theme.PushControl.PopupOverlay</item>
    </style>

    <!-- Окончательный рабочий стиль для выпадающего меню -->
    <style name="Theme.PushControl.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <!-- 1. Главный переключатель: меняем цвет всей поверхности Material-меню на КРАСНЫЙ -->
        <item name="colorSurface">#FFFFFF</item>

        <!-- 2. Меняем цвет текста и иконок на БЕЛЫЙ -->
        <item name="colorOnSurface">#000000</item>
        <item name="android:textColor">#000000</item>

        <!-- 3. Сбрасываем старые параметры, чтобы они не мешали -->
        <item name="android:itemBackground">@null</item>
    </style>



    <style name="Theme.PushControl.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.PushControl.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
</resources>
